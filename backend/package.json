{
  "name": "meeting-action-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seeds/devUsers.js",
    "credentials:rotate": "node src/scripts/rotateCredentials.js",
    "activities:backfill": "node src/scripts/backfillActivities.js",
    "correlation:queue": "node src/scripts/queueCorrelation.js",
    "webhooks:gateway": "node src/scripts/webhookGateway.js",
    "test": "NODE_ENV=test MEETING_TIMEZONE=UTC node --test --test-concurrency=1 'test/**/*.test.js'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "10.0.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
